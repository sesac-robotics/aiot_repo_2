   <string notr="true">
QMainWindow { background-color: #F8FAFC; }
#profileTitle { font-size: 22px; font-weight: 900; color: #0F172A; }
#settingsCard { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 20px; padding: 15px; }
QLabel { font-size: 13px; font-weight: 700; color: #334155; background: transparent; }
QLineEdit, QComboBox { background-color: #F8FAFC; border: 2px solid #E2E8F0; border-radius: 10px; padding: 4px 10px; color: #0F172A; font-size: 13px; min-height: 24px; }
QLineEdit:focus, QComboBox:focus { border: 2px solid #0284C7; background-color: #FFFFFF; }
QLineEdit[readOnly="true"] { background-color: #E2E8F0; color: #64748B; border: 2px solid #CBD5E1; }

#errorMsgLabel { font-size: 12px; font-weight: 700; color: #EF4444; background: transparent; }

#saveButton { background-color: #0284C7; color: #FFFFFF; font-size: 14px; font-weight: 800; border-radius: 12px; min-height: 38px; }
#saveButton:hover { background-color: #0369A1; }

#changePasswordButton { background-color: #0F766E; color: #FFFFFF; font-size: 13px; font-weight: 800; border-radius: 10px; min-height: 36px; }
#changePasswordButton:hover { background-color: #115E59; }

#deleteAccountButton { background-color: #FEF2F2; color: #EF4444; font-size: 13px; font-weight: 800; border: 1px solid #FECACA; border-radius: 10px; min-height: 38px; }
#deleteAccountButton:hover { background-color: #FEE2E2; }

#backDashboardButton { background-color: #FFFFFF; color: #64748B; font-size: 13px; font-weight: 700; border: 1px solid #CBD5E1; border-radius: 10px; min-height: 38px; }
#backDashboardButton:hover { background-color: #F1F5F9; color: #0F172A; }
   </string>
