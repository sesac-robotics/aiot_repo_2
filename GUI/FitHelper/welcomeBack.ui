  <property name="styleSheet">
   <string notr="true">
QMainWindow { background-color: #F8FAFC; }
#welcomeTitle { font-size: 26px; font-weight: 900; color: #0F172A; background: transparent; }
#profileButton { background-color: #FFFFFF; color: #0284C7; font-size: 13px; font-weight: 800; border: 1px solid #E2E8F0; border-radius: 12px; }
#profileButton:hover { background-color: #F0F9FF; border: 1px solid #0284C7; }

/* 로그아웃 버튼 스타일 */
#logoutButton { background-color: #FEF2F2; color: #EF4444; font-size: 13px; font-weight: 800; border: 1px solid #FECACA; border-radius: 12px; }
#logoutButton:hover { background-color: #FEE2E2; border: 1px solid #EF4444; }

/* 체형 분석 유도 배너 카드 스타일 */
#analysisNudgeCard { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0284C7, stop:1 #0369A1); border-radius: 18px; padding: 15px; }
#nudgeTitleLabel { font-size: 15px; font-weight: 800; color: #FFFFFF; background: transparent; }
#nudgeDescLabel { font-size: 12px; font-weight: 600; color: #E0F2FE; background: transparent; }
#startAnalysisBannerButton { background-color: #FFFFFF; color: #0284C7; font-size: 13px; font-weight: 800; border-radius: 10px; }
#startAnalysisBannerButton:hover { background-color: #F8FAFC; }

/* 오늘의 운동 카드 스타일 (AI 맞춤형) */
#todayRoutineCard { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 20px; padding: 16px; }
#todayRoutineLabel { font-size: 15px; font-weight: 800; color: #1E293B; background: transparent; }
#todayDescLabel { font-size: 13px; font-weight: 600; color: #64748B; background: transparent; }

/* 토글 버튼 스타일 (7일 전체 보기 토글) */
#toggleRoutineButton { background-color: #F1F5F9; color: #475569; font-size: 11px; font-weight: 800; border: 1px solid #CBD5E1; border-radius: 8px; }
#toggleRoutineButton:checked { background-color: #0284C7; color: #FFFFFF; border: 1px solid #0284C7; }

#startWorkoutButton { background-color: #0284C7; color: #FFFFFF; font-size: 14px; font-weight: 900; border-radius: 12px; min-height: 42px; }
#startWorkoutButton:hover { background-color: #0369A1; }

/* 7일 전체 루틴 리스트 스타일 */
#day1Item, #day2Item, #day3Item, #day4Item, #day5Item, #day6Item, #day7Item { font-size: 12px; font-weight: 700; color: #334155; background-color: #F8FAFC; border-radius: 6px; padding-left: 8px; }

/* 하단 운동 히스토리 버튼 스타일 */
#historyButton { background-color: #FFFFFF; color: #64748B; font-size: 13px; font-weight: 800; border: 1px solid #CBD5E1; border-radius: 14px; min-height: 44px; }
#historyButton:hover { background-color: #F1F5F9; color: #0F172A; }

#bodyAnalysisSummaryCard { background-color: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 14px; }
#bodyAnalysisSummaryTitle { color: #15803D; font-size: 14px; font-weight: 800; background: transparent; }
#bodyAnalysisSummaryLabel { color: #334155; font-size: 12px; font-weight: 700; background: transparent; }
   </string>
