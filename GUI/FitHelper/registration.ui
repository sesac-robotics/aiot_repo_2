   <string notr="true">
QMainWindow { background-color: #F8FAFC; }
#registerTitle { font-size: 24px; font-weight: 900; color: #0284C7; }
#regCard { background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 20px; padding: 20px; }
QLabel { font-size: 13px; font-weight: 700; color: #334155; background: transparent; }
QLineEdit, QComboBox { background-color: #F8FAFC; border: 2px solid #E2E8F0; border-radius: 10px; padding: 6px 12px; color: #0F172A; font-size: 14px; min-height: 28px; }
QLineEdit:focus, QComboBox:focus { border: 2px solid #0284C7; background-color: #FFFFFF; }
#errorMsgLabel { color: #EF4444; font-size: 12px; font-weight: 700; background: transparent; }
#registerButton { background-color: #0284C7; color: #FFFFFF; font-size: 15px; font-weight: 800; border-radius: 14px; min-height: 48px; }
#registerButton:hover { background-color: #0369A1; }
#backButton { background-color: #FFFFFF; color: #64748B; font-size: 13px; font-weight: 700; border: 1px solid #CBD5E1; border-radius: 14px; min-height: 40px; }
#backButton:hover { background-color: #F1F5F9; color: #0F172A; }
