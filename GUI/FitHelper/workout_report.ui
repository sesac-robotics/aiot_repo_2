  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget { background-color: #F1F5F9; color: #0F172A; }
QLabel#pageTitle { color: #0F172A; font-size: 25px; font-weight: 900; }
QLabel#pageSubtitle { color: #64748B; font-size: 13px; }
QFrame#summaryCard, QFrame#exerciseCard, QFrame#scoreCard, QFrame#feedbackCard { background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; }
#dateHeading, #timeHeading, #exerciseHeading, #averageScoreCaption { color: #475569; font-size: 13px; font-weight: 700; }
#dateValue, #timeValue, #exerciseValue { color: #0F172A; font-size: 16px; font-weight: 800; }
QLabel#averageScoreValue { color: #0284C7; font-size: 27px; font-weight: 900; }
#scoreSectionTitle, #feedbackSectionTitle { color: #0F172A; font-size: 16px; font-weight: 800; }
QTableWidget { background: #FFFFFF; border: none; gridline-color: #E2E8F0; selection-background-color: #E0F2FE; selection-color: #0F172A; }
QHeaderView::section { background: #F8FAFC; color: #475569; border: none; border-bottom: 1px solid #E2E8F0; padding: 8px; font-weight: 700; }
QPlainTextEdit#badFeedbackText { background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 10px; padding: 10px; color: #78350F; font-size: 13px; }
QPushButton#backDashboardButton { background: #0284C7; color: white; font-weight: 800; border: none; border-radius: 12px; min-height: 44px; }
QPushButton#backDashboardButton:hover { background: #0369A1; }
   </string>
