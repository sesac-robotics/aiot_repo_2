# Camera input: http (default) or rtsp; only the selected URL is required.
CAMERA_SOURCE_TYPE=http
# ESP32-CAM HTTP video stream URL
ESP32_STREAM_URL=http://YOUR_ESP32_CAM_IP/stream
# Copy the complete RTSP address shown by OctoStream; do not commit credentials.
RTSP_STREAM_URL=rtsp://YOUR_IPHONE_IP:PORT/PATH
RTSP_TRANSPORT=tcp

# Available options:
# - yolo
# - mediapipe
POSE_MODEL=yolo
# YOLO Pose model path
YOLO_MODEL_PATH=models/YOLO/yolo26m-pose.pt
# MediaPipe Pose Landmarker model path
MEDIAPIPE_MODEL_PATH=models/MediaPipe/pose_landmarker_full.task
# MediaPipe Pose device list
# - cpu
# - gpu
MEDIAPIPE_DELEGATE=gpu
# Performance log interval in seconds (positive finite number; default: 5)
METRICS_LOG_INTERVAL_SECONDS=5

# AIFit -> AI Server: X-Internal-API-Key header (empty disables internal API with 503)
INTERNAL_API_KEY=X-Internal-API-Key header

# Shoulder Press diagnostics only: 1 enables; restart server after changing
SHOULDER_PRESS_DEBUG=0

# Learned posture classification (independent of Reps/Hold); restart after editing.
POSTURE_MODEL_ENABLED=false
# 승인된 반복마다 AIFit records API에 비동기 POST. 빈 값이면 전송하지 않습니다.
AIFIT_RECORDS_URL=http://10.17.178.246:8000/api/workout-sessions/{session_id}/records
# 별도 서버 키가 필요하면 설정합니다. 미설정 시 INTERNAL_API_KEY 사용.
# AIFIT_INTERNAL_API_KEY=
POSTURE_MODEL_DIR=/home/ssw/Desktop/posture_classification_handoff_v2_feedback
# Team default CNN; GRU is also supported. CPU avoids extra MediaPipe GPU contention.
POSTURE_MODEL_ARCHITECTURE=cnn
POSTURE_MODEL_DEVICE=cpu

# Optional explicit mode: rule_based / model / off; overrides POSTURE_MODEL_ENABLED.
# Omit this key to preserve the legacy POSTURE_MODEL_ENABLED behavior.
# POSTURE_EVALUATION_MODE=rule_based
# Rule-based: camera direction must be configured; unknown never certifies unobserved checks.
POSTURE_CAMERA_VIEW=unknown
# Experimental posture thresholds only; no effect on Reps/Hold configuration.
# POSTURE_RULE_CONFIG='{"confirm_sec":0.4,"clear_sec":0.25}'
# Optional per-exercise directions; must match the actual filming position.
# POSTURE_CAMERA_VIEWS='{"squat":"side","push_up":"side","plank":"side","ytw_raise":"front","dumbbell_shoulder_press":"front"}'

# Squat Reps path diagnostics; logs thresholds/joints/phases/events, never changes counting.
SQUAT_DEBUG=0
