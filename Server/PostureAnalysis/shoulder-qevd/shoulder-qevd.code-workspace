{
  "folders": [
    {
      "name": "5종목 자세 라벨링",
      "path": "."
    },
    {
      "name": "자세 오류 모델 학습",
      "path": "../posture-error-training"
    }
  ],
  "settings": {},
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "ESP32-CAM 실시간 자세 오류 테스트",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:자세 오류 모델 학습}/run_esp32cam_live.py",
        "cwd": "${workspaceFolder:자세 오류 모델 학습}",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder:자세 오류 모델 학습}",
        "console": "integratedTerminal",
        "justMyCode": true,
        "name": "학습 모델로 영상 또는 ESP32-CAM 추론",
        "program": "${workspaceFolder:자세 오류 모델 학습}/predict_exercise.py",
        "args": [
          "--exercise",
          "${input:predictExercise}",
          "--source",
          "${input:videoSource}"
        ]
      },
      {
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder:자세 오류 모델 학습}",
        "console": "integratedTerminal",
        "justMyCode": true,
        "name": "5종목 학습 결과 화면 열기",
        "program": "${workspaceFolder:자세 오류 모델 학습}/run_all_training_results.py",
        "args": []
      },
      {
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder:자세 오류 모델 학습}",
        "console": "integratedTerminal",
        "justMyCode": true,
        "name": "종목 선택해서 학습",
        "program": "${workspaceFolder:자세 오류 모델 학습}/run_remaining_exercises.py",
        "args": [
          "--exercise",
          "${input:remainingExercise}"
        ]
      },
      {
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder:자세 오류 모델 학습}",
        "console": "integratedTerminal",
        "justMyCode": true,
        "name": "나머지 4종목 CNN + GRU 학습",
        "program": "${workspaceFolder:자세 오류 모델 학습}/run_remaining_exercises.py",
        "args": []
      },
      {
        "name": "스쿼트 CNN + GRU 학습",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:자세 오류 모델 학습}/run_training.py",
        "cwd": "${workspaceFolder:자세 오류 모델 학습}",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "name": "▶ 5종목 라벨 + 영상 실행",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/run_five_exercises.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "justMyCode": true
      },
      {
        "name": "▶ 영상 + 교정 문구 자동 실행",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/run_demo.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "args": [],
        "justMyCode": true
      }
    ],
    "inputs": [
      {
        "id": "remainingExercise",
        "type": "pickString",
        "description": "학습 종목",
        "options": [
          "pushups",
          "elbow_plank",
          "ytw",
          "shoulder_press"
        ]
      },
      {
        "id": "predictExercise",
        "type": "pickString",
        "description": "추론 종목",
        "options": [
          "squats",
          "pushups",
          "elbow_plank",
          "ytw",
          "shoulder_press"
        ]
      },
      {
        "id": "videoSource",
        "type": "promptString",
        "description": "영상 절대 경로, 웹캠 번호(0), 또는 ESP32-CAM URL",
        "default": "0"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "5종목 라벨링 재생성",
        "type": "process",
        "command": "python3",
        "args": [
          "${workspaceFolder}/build_five_exercises.py"
        ],
        "problemMatcher": []
      },
      {
        "label": "테스트 화면 실행",
        "type": "process",
        "command": "python3",
        "args": [
          "${workspaceFolder}/run_demo.py"
        ],
        "problemMatcher": []
      },
      {
        "label": "서버 기능 테스트",
        "type": "process",
        "command": "python3",
        "args": [
          "${workspaceFolder}/test_app/test_server.py"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "데이터셋 무결성 검증",
        "type": "process",
        "command": "python3",
        "args": [
          "${workspaceFolder}/validate_dataset.py"
        ],
        "problemMatcher": []
      }
    ]
  }
}
